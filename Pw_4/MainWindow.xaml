<Window x:Class="Pw_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pw_4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Menu VerticalAlignment="Top" Grid.ColumnSpan="2">
            <MenuItem Name="btn_about_programm" Header="О программе" Click="btn_about_programm_Click"/>
            <MenuItem Name="btn_exit" Header="Выход" Click="btn_exit_Click"/>
            <CheckBox Name="cb_WorkWithPair_ChoosePair" Content="Добавить объект в список/Использовать объекты из списка" Click="cb_WorkWithPair_ChoosePair_Click"/>
        </Menu>
        <ListBox x:Name="lb_of_objects" Grid.Column="0" Margin="25"/>
        <StackPanel Grid.Column="1" Margin="50" VerticalAlignment="Center">
            <Label x:Name="lbl_first" Content="Первый параметр:" Foreground="White" HorizontalAlignment="Center"/>
            <TextBox x:Name="tb_first_parametr"/>
            <Label x:Name="lbl_second" Content="Второй параметр:" Foreground="White" HorizontalAlignment="Center"/>
            <TextBox x:Name="tb_second_parametr"/>
            <Label Name="lbl_third" Content="Третий номер пары:" Foreground="White" Visibility="Collapsed" HorizontalAlignment="Center"/>
            <TextBox x:Name="tb_third_parametr" Visibility="Collapsed"/>
            <Button x:Name="btn_add_to_list"  Height="20" Margin="5" Content="Добавить в список" Click="btn_add_to_list_Click"/>
            <Button x:Name="btn_sum_pair_elements"  Height="20" Margin="5" Content="Сложить элементы пар" Visibility="Collapsed" Click="btn_sum_pair_elements_Click"/>
        </StackPanel>
    </Grid>
</Window>
